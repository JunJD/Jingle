{
  "name": "@jingle/extension-cli",
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "jingle-extension": "./src/cli.mjs"
  },
  "files": [
    "src/"
  ],
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/cli.mjs",
    "./identity": {
      "types": "./src/extension-identity.d.mts",
      "default": "./src/extension-identity.mjs"
    },
    "./installed-package-path": {
      "types": "./src/installed-package-path.d.mts",
      "default": "./src/installed-package-path.mjs"
    }
  },
  "dependencies": {
    "esbuild": "~0.28.2",
    "semver": "^7.8.5",
    "typescript": "^5.9.3"
  }
}
